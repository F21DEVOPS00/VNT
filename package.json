{
  "name": "meeting-notes",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "web": "expo start --web",
    "server": "node --env-file-if-exists=server/.env server/index.mjs",
    "typecheck": "tsc --noEmit",
