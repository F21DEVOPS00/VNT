{
  "name": "meeting-notes",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "web": "expo start --web",
    "server": "node --env-file-if-exists=server/.env server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs",
    "build:web": "expo export --platform web",
    "start:dev-client": "expo start --dev-client"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "cors": "^2.8.6",
    "expo": "~58.0.17",
    "expo-audio": "^58.0.10",
    "expo-dev-client": "^58.0.14",
    "expo-document-picker": "^58.0.4",
    "expo-file-system": "^58.0.10",
    "expo-secure-store": "^58.0.2",
    "expo-sharing": "^58.0.20",
    "expo-status-bar": "~58.0.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.0",
    "openai": "^7.41.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3"
  }
