OPENAI_API_KEY=
# Generate a long random connection password; enter the same value in the iPhone app.
MEETING_ACCESS_TOKEN=
TRANSCRIPTION_MODEL=gpt-transcribe
SUMMARY_MODEL=gpt-4.1-mini
PORT=8787
# Local network development only. Use HTTPS + proper per-user authentication before hosting publicly.
HOST=0.0.0.0

# Public service authentication (Supabase email/password with email confirmation enabled).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only; enables in-app account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# SMTP sender. Use a verified sender/domain; recipients are placed in BCC.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Set production only after all external services are configured.
NODE_ENV=development
